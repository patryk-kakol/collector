<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <!-- Console Appender For local dev, choose between json and pattern layout -->
        <SpringProfile name="local">
            <Console name="Console" target="SYSTEM_OUT">
                <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level [%X{serverId}] %logger{36} - %msg%n"/>
            </Console>
<!--            <Console name="Console" target="SYSTEM_OUT">-->
<!--                <JsonTemplateLayout eventTemplateUri="classpath:CustomJsonEventLayout.json"/>-->
<!--            </Console>-->
        </SpringProfile>

        <!-- Console Appender for default profile -->
        <SpringProfile name="default">
            <Console name="Console" target="SYSTEM_OUT">
                <JsonTemplateLayout eventTemplateUri="classpath:CustomJsonEventLayout.json"/>
            </Console>
        </SpringProfile>

        <!-- JobRunr Dashboard Appender -->
        <JobRunrAppender name="JobRunrDashboard"/>
    </Appenders>

    <Loggers>
        <Root level="info">
            <AppenderRef ref="Console"/>
        </Root>

        <Logger name="org.pk.collector" level="info" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <Logger name="org.pk.collector.integration.sftp.SftpClientProvider" level="info" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="JobRunrDashboard"/>
        </Logger>

        <Logger name="net.schmizz.sshj" level="info" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="JobRunrDashboard"/>
        </Logger>

        <Logger name="org.springframework" level="info" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
    </Loggers>
</Configuration>
